  m_Script: {fileID: 11500000, guid: 9bfda527630e6e5409474fa4c2daed3e, type: 3}
  m_Name: DialogueData
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  talkScript:
  - name: "Ant\xF4nio"
    text: "Muito boa tarde, senhor. O que deseja? Texas hold \u2018em, blackjack?"
  - name: Icaro
    text: "N\xE3o curto jogos do tipo. O que mais voc\xEAs tem? "
  - name: "Ant\xF4nio"
    text: "Primeira vez no \xC9den? Maravilha! Temos de tudo um pouco, senhor. Meu conselho? A apresenta\xE7\xE3o da noite ser\xE1 em breve. Sempre d\xE3o um ar novo ao ambiente.  "
  - name: Icaro
    text: "Vou esperar para ver ent\xE3o. Muito obrigado, Ant\xF4nio. Nos vemos em outra hora"
  - name: "Ant\xF4nio"
    text: O prazer foi todo meu. Aproveite a noite, senhor.
